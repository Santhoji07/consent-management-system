# Consent Management System - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============================================
# Fabric Network Configuration
# ============================================
FABRIC_SAMPLES_PATH=../../fabric-samples
CHANNEL_NAME=consentchannel
CHAINCODE_NAME=consentcc

# ============================================
# Organization 1 Configuration
# ============================================
ORG1_MSP_ID=Org1MSP
ORG1_PEER_ENDPOINT=localhost:7051
ORG1_PEER_HOST_ALIAS=peer0.org1.example.com
ORG1_CA_ENDPOINT=localhost:7054
ORG1_CONNECTION_PROFILE=../../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/connection-org1.json
ORG1_ADMIN_CERT=../../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/cert.pem
ORG1_ADMIN_KEY=../../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore

# ============================================
# Organization 2 Configuration
# ============================================
ORG2_MSP_ID=Org2MSP
ORG2_PEER_ENDPOINT=localhost:9051
ORG2_PEER_HOST_ALIAS=peer0.org2.example.com
ORG2_CA_ENDPOINT=localhost:8054
ORG2_CONNECTION_PROFILE=../../fabric-samples/test-network/organizations/peerOrganizations/org2.example.com/connection-org2.json

# ============================================
# Default Organization
# ============================================
DEFAULT_ORG=org1

# ============================================
# Wallet Paths
# ============================================
WALLET_PATH=./fabric/wallet
ORG1_WALLET_PATH=./fabric/wallet
ORG2_WALLET_PATH=./fabric/wallet-org2

# ============================================
# Discovery Settings
# ============================================
DISCOVERY_ENABLED=false
DISCOVERY_AS_LOCALHOST=true

# ============================================
# Admin Identity
# ============================================
ADMIN_IDENTITY_NAME=admin

